{
  "name": "drivosafe-native",
  "version": "1.0.0",
  "private": true,
  "description": "DrivoSafe in-cab tablet app \u2014 bare React Native, Skia HUD. Android is the supported target (SYSTEM_DESIGN \u00a74.1).",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
