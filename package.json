{
  "name": "drivosafe",
  "version": "1.0.0",
  "private": true,
  "description": "DrivoSafe \u2014 in-cab road-intelligence assistant for bus fleets",
  "workspaces": [
    "shared",
    "app",
    "native"
  ],
  "scripts": {
    "test": "npm run test --workspace @drivosafe/shared",
    "web": "npm run dev --workspace drivosafe-web",
    "web:build": "npm run build --workspace drivosafe-web",
    "native": "npm run start --workspace drivosafe-native",
    "postinstall": "patch-package",
    "check": "node scripts/check-undefined.mjs && npm test"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
